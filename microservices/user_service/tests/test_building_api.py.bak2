            "street": f"With Coords {i}",
            "house_number": str(i + 1),
            "latitude": 41.0 + i * 0.01,
            "longitude": 69.0 + i * 0.01
        }

        response = await test_client.post(
            "/api/v1/buildings",
            json=building_data,
            headers=auth_headers
        )

        buildings.append(response.json())

    # Create 5 without coordinates
    for i in range(5):
        building_data = {
            "management_company_id": str(test_company_id),
            "city": "Tashkent",
            "street": f"Without Coords {i}",
            "house_number": str(i + 1)
        }

        response = await test_client.post(
            "/api/v1/buildings",
            json=building_data,
            headers=auth_headers
        )

        buildings.append(response.json())

    return buildings
