# Analytics Service Environment Variables
# Copy to .env and update values

# Application
DEBUG=True
ANALYTICS_PORT=8006

# Database
POSTGRES_USER=analytics_user
POSTGRES_PASSWORD=analytics_pass
POSTGRES_DB=analytics_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=2
REDIS_PASSWORD=

# Redis Streams
REDIS_STREAM_NAME=analytics:events
REDIS_CONSUMER_GROUP=analytics-consumers
REDIS_CONSUMER_NAME=analytics-consumer-1
REDIS_BLOCK_TIME=5000
REDIS_BATCH_SIZE=100

# Cache
CACHE_TTL=300

# Event Processing
MAX_WORKERS=3
EVENT_BATCH_SIZE=100
EVENT_RETENTION_DAYS=30

# Metrics
METRICS_UPDATE_INTERVAL=3600
METRICS_CACHE_TTL=300

# Security
SECRET_KEY=change-me-in-production

# Auth Service
AUTH_SERVICE_URL=http://auth-service:8001

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
