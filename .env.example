# UK Management Bot — Docker Environment Configuration
#
# ЕДИНСТВЕННЫЙ канонический пример окружения корневого стека (AUD5-PRAC-1,
# 2026-07-26). Раньше их было пять, и они противоречили друг другу: `env.example`
# требовал `SECRET_KEY`/`JWT_SECRET_KEY`, которых код не читает вообще (настройка
# называется `JWT_SECRET`), и не содержал ни одного из обязательных
# `JWT_SECRET`/`INVITE_SECRET`/`UK_WEBHOOK_SECRET`/`ADMIN_PASSWORD` — то есть
# fresh-install по README не поднимался; `env.dev.example` и
# `uk_management_bot/.env.example` были пустыми файлами;
# `uk_management_bot/production.env.example` отставал на 16 ключей. Все четыре
# удалены. Отдельные примеры остались только у того, у кого своя область:
# `media_service/.env.example`, `tests/e2e/.env.example`, `.env.postgres.example`
# (PR-7 role-файлы), `.env.production.template`.
#
# Скопируйте этот файл в .env и заполните реальными значениями.
#
# ARCH-106 (Doppler cutover, ЗАКРЫТ целиком 2026-07-21): на прод-хостах
# (profk/infrasafe) секреты для app/api/access-api/migrate/resource-api/
# resource-worker И media-service (BOT_TOKEN, ADMIN_PASSWORD, JWT_SECRET,
# INVITE_SECRET, ACCESS_*, MEDIA_*, REDIS_PASSWORD, RESOURCE_*,
# HEALTH_METRICS_TOKEN, INFRASAFE_INVENTORY_TOKEN, UK_WEBHOOK_SECRET,
# INFRASAFE_WEBHOOK_SECRET) приходят из Doppler (`doppler run --`), НЕ из .env —
# см. `.claude/skills/uk-deploy/SKILL.md`. Для локальной разработки .env
# используется как обычно.

# ═══════════════════════════════════════════════════════════════
# ОБЯЗАТЕЛЬНЫЕ НАСТРОЙКИ БЕЗОПАСНОСТИ
# ═══════════════════════════════════════════════════════════════

# Telegram Bot Token (получить у @BotFather)
# ВАЖНО: Замените на ваш реальный токен!
BOT_TOKEN=your_bot_token_from_botfather
MEDIA_BOT_TOKEN=your_media_bot_token

# КРИТИЧНО: Смените дефолтный пароль!
# Используйте: openssl rand -base64 32
ADMIN_PASSWORD=change_me_strong_password

# КРИТИЧНО: Секрет для подписи инвайт-токенов
# Используйте: openssl rand -base64 64
INVITE_SECRET=generate_with_openssl_rand_base64_48

# ARCH-010: идентификатор инсталляции — левая часть UUIDv5-name исходящих
# вебхуков. НЕ секрет, но заморожен навсегда: смена значения меняет все будущие
# event_id и ломает дедуп InfraSafe. На проде из Doppler: profk|infrasafe.
# Локально/CI — dev. Не пустое: compose-гард :? требует значение.
OUTBOX_SOURCE_INSTANCE=dev

# ═══════════════════════════════════════════════════════════════
# БАЗА ДАННЫХ
# ═══════════════════════════════════════════════════════════════

# PR-7 (F-01): admin/superuser-креды (POSTGRES_DB/USER/PASSWORD/INITDB_ARGS)
# вынесены в отдельный файл .env.postgres (см. .env.postgres.example) — не
# сюда. app/api/access-api/bot больше не читают DATABASE_URL из .env: каждый
# получает свой role-специфичный ./.secrets/roles/.env.<role>, который
# генерирует scripts/provision_roles.sh (см. план PR-7, «Изоляция credentials»).

POSTGRES_PORT=5432


# ═══════════════════════════════════════════════════════════════
# REDIS (Docker автоматически настроит)
# ═══════════════════════════════════════════════════════════════

REDIS_URL=redis://redis:6379/0

# Redis connection string для Media Service (DB 1)
MEDIA_REDIS_URL=redis://redis:6379/2

# Использовать Redis для rate limiting
USE_REDIS_RATE_LIMIT=true

# Redis settings
REDIS_MAX_MEMORY=512mb
REDIS_POLICY=allkeys-lru

# Redis порт (по умолчанию 6379)
# Для production рекомендуется не exposed наружу (закомментируйте ports в docker-compose)
REDIS_PORT=6379


# ═══════════════════════════════════════════════════════════════
# АДМИНИСТРАТОРЫ И КАНАЛЫ
# ═══════════════════════════════════════════════════════════════

# Telegram ID администраторов (через запятую)
# ВАЖНО: Замените на реальные ID администраторов!
ADMIN_USER_IDS=123456789

# Канал для уведомлений (опционально)
# ВНИМАНИЕ: замените на реальный ID канала (например, -1001234567890) или оставьте пустым.
# Placeholder-значения вида "@your_notifications_channel" или "your_channel_id" будут проигнорированы.
TELEGRAM_CHANNEL_ID=

# URL Media Service (внутренний для бота)
MEDIA_SERVICE_URL=http://media-service:8000

# Путь к файлу с каналами
CHANNELS_FILE_PATH=/app/data/channels.json

# Директория для загрузок
UPLOAD_DIR=/app/data/uploads

# Telegram каналы для хранения медиа (ID каналов с минусом)
# По умолчанию используются каналы из config.py, но можно переопределить
CHANNEL_REQUESTS=-100your_channel_id
CHANNEL_REPORTS=-100your_channel_id
CHANNEL_ARCHIVE=-100your_channel_id
CHANNEL_BACKUP=-100your_channel_id

# Максимальный размер файла (в байтах, 50MB по умолчанию)
MAX_FILE_SIZE=52428800

# Разрешенные расширения файлов
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,mp4,mov,avi,pdf,doc,docx,xls,xlsx,zip

# Media Service API ключ (опционально)
MEDIA_API_KEY=generate_with_openssl_rand_hex_32

# Sentry error-tracking (опционально, AUD6-P2-37). Пустое значение = выключен:
# init в main.py/api условный, compose пробрасывает без :?-гарда. На проде
# значение живёт в Doppler (project uk-management), как остальные секреты.
SENTRY_DSN=

# ═══════════════════════════════════════════════════════════════
# ПРОИЗВОДИТЕЛЬНОСТЬ И БЕЗОПАСНОСТЬ
# ═══════════════════════════════════════════════════════════════

# Production режим (ОБЯЗАТЕЛЬНО!)
DEBUG=false

# Уровень логирования (ERROR, WARNING, INFO, DEBUG)
LOG_LEVEL=INFO

# Rate limiting для /join команды
JOIN_RATE_LIMIT_WINDOW=600  # 10 минут
JOIN_RATE_LIMIT_MAX=3       # 3 попытки

# ═══════════════════════════════════════════════════════════════
# УВЕДОМЛЕНИЯ
# ═══════════════════════════════════════════════════════════════

# Включить уведомления
ENABLE_NOTIFICATIONS=true

# Количество попыток отправки уведомлений
NOTIFICATION_RETRY_COUNT=3

# ═══════════════════════════════════════════════════════════════
# MEDIA SERVICE ИНТЕГРАЦИЯ
# ═══════════════════════════════════════════════════════════════

# URL Media Service (localhost т.к. media service в отдельной сети)

# Таймаут запросов к Media Service (секунды)
MEDIA_SERVICE_TIMEOUT=30

# Включить Media Service
MEDIA_SERVICE_ENABLED=true

# ═══════════════════════════════════════════════════════════════
# GOOGLE SHEETS ИНТЕГРАЦИЯ (ОПЦИОНАЛЬНО)
# ═══════════════════════════════════════════════════════════════

# Путь к файлу с credentials от Google (внутри контейнера)
GOOGLE_SHEETS_CREDENTIALS_FILE=path_to_credentials.json

# ID Google Spreadsheet для экспорта
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id

# ═══════════════════════════════════════════════════════════════
# DOCKER СПЕЦИФИЧНЫЕ НАСТРОЙКИ
# ═══════════════════════════════════════════════════════════════

# Python путь в контейнере
PYTHONPATH=/app

# Небуферизованный вывод Python
PYTHONUNBUFFERED=1

# ═══════════════════════════════════════════════════════════════
# ПРОВЕРКА КОНФИГУРАЦИИ
# ═══════════════════════════════════════════════════════════════

# После настройки запустите: docker-compose up -d
# И проверьте логи: docker-compose logs app

#  ==================== LOGGING ====================
# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Формат логов: text, json
LOG_FORMAT=text

# Путь к файлу логов (опционально)
LOG_FILE=



# ==================== PERFORMANCE ====================
# Количество воркеров для обработки запросов
WORKERS_COUNT=2

# Размер пула соединений к БД
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Таймауты (в секундах)
REQUEST_TIMEOUT=30
DB_TIMEOUT=10
REDIS_TIMEOUT=5



# InfraSafe webhook integration
# ⚠️ ARCH-106: на прод-хостах *_SECRET приходит из Doppler (`doppler run --`), не отсюда;
# *_ENABLED/*_URL — не секреты и остаются в .env.
INFRASAFE_WEBHOOK_ENABLED=true
INFRASAFE_WEBHOOK_URL=https://your-webhook-endpoint
INFRASAFE_WEBHOOK_SECRET=generate_with_openssl_rand_hex_32

# Dual-secret ротация партнёрских webhook-секретов (settings.py §4.4/R-18).
# Секрет разделён с InfraSafe — односторонняя смена рвёт живую интеграцию, поэтому
# ротация идёт через grace-window: верификатор принимает OLD || NEW, а подписант
# переключается флагом. Заполняются только на время ротационного окна (на проде —
# в Doppler), потом значение переносится в основной ключ и *_NEXT очищается.
# Полная процедура → .claude/skills/uk-deploy/SKILL.md.
INFRASAFE_WEBHOOK_SECRET_NEXT=
INFRASAFE_USE_NEXT_SECRET=false
UK_WEBHOOK_SECRET_NEXT=

# ARCH-114: инвентарная сверка заявок (reconciliation читает GET .../api/uk-requests-metrics).
INFRASAFE_REQUESTS_INVENTORY_URL=https://your-infrasafe-host/api/uk-requests-metrics
RECONCILE_REQUESTS_ENABLED=false
# Общий секрет service-token гейта (H-4). Пусто = заголовок не шлём, эндпоинт
# публичен как сейчас. Значение согласовать с InfraSafe; активировать в связке:
# сначала мы шлём токен, затем InfraSafe включает свой UK_INVENTORY_TOKEN.
INFRASAFE_INVENTORY_TOKEN=

# Resource Accounting («Учёт ресурсов УК») — iframe launch-ticket.
# Токен получить у партнёра безопасным каналом; пусто = интеграция выключена
# (ticket-эндпоинт отвечает 503). Токен НИКОГДА не уходит в браузер.
RESOURCE_SERVICE_URL=https://resources-api.infrasafe.uz/v1
RESOURCE_SERVICE_TOKEN=

# Визуальные отчёты «до/после» на публичном табло (work-reports).
# false = фича выключена целиком: модуль вырезается из board-config, публичная
# лента отдаёт пустой список, менеджерский API отвечает 404. Держать
# синхронно с билд-аргом фронта VITE_WORK_REPORTS_ENABLED — иначе UI будет
# показывать раздел, которого нет на бэкенде (или наоборот).
WORK_REPORTS_ENABLED=false
# Потолок размера ОДНОГО публично отдаваемого фото. Проверяется по метаданным
# media-service при autofill/publish и повторно по фактическим байтам в
# стриме (метаданные — заявление, не гарантия).
PUBLIC_MEDIA_MAX_BYTES=8388608

# UK API secrets — generate each with: openssl rand -hex 32
UK_WEBHOOK_SECRET=generate_with_openssl_rand_hex_32
JWT_SECRET=generate_with_openssl_rand_hex_32
